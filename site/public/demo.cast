[0.003, "o", "t-sheet.jpg six\u001b[27Gtimes. Each read\u001b[44Gadds the image to \u001b[63Gontex\u001b[69G again.\u001b[77GDescribe what m\u001b[93Gtters in text\u001b[107G\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gonce, or crop to the part that changed. \u001b]8;id=clioal;https://code.claude.com/docs/en/costs.md\u0007\u001b[94mDocs\u001b[39m\u001b]8;;\u0007\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BCompactions themselves are cheap: 35 rebuilds cost\u001b[54Gabout 0.1%. The \u001b[71Gxpense comes\u001b[84Gfrom the context growing\u001b[109Gso\r\u001b[2C\u001b[1Blarge before compaction.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNext step\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1BThe two la\u001b[14Ggest levers are\u001b[30G\u001b[38;2;177;185;249mautoCompactWindow\u001b[48G\u001b[39mfor\u001b[52Gthe\u001b[56Glate\u001b[61Gcompaction\u001b[72Gand\u001b[76G\u001b[38;2;177;185;249mCLAUDE_CODE_SUBAGENT_MODEL\u001b[103G\u001b[39mplus\u001b[108Gan\r\u001b[2C\u001b[1BExplore\u001b[11Goverride\u001b[20Gfor\u001b[24Gthe\u001b[28Gsubagents.\u001b[39GRun\u001b[43G\u001b[38;2;177;185;249m/tokendoctor:audit\u001b[62G\u001b[39mto\u001b[65Gcheck\u001b[71Gand\u001b[75Gfix\u001b[79Gthem.\u001b[85GThis\u001b[90Gskill\u001b[96Gdoesn't\u001b[104Gedit\r\u001b[2C\u001b[1Bfiles.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mWhat this can't see\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B- P\u001b[7Gr-model\u001b[15Gprices,\u001b[23Gwhich\u001b[29Gis\u001b[32"]
